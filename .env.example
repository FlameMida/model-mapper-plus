# smoke-local 配置。复制为 .env 并填值（.env 已 gitignore，勿提交）。
# `make smoke-local` 会自动加载本目录的 .env。

# management key 明文（config.yaml 的 remote-management.secret-key 存的是哈希，
# 这里填哈希之前的原文）
CPA_SMOKE_MGMT_KEY=

# 客户端 api-key（config.yaml api-keys 列表之一，原样抄）
CPA_SMOKE_CLIENT_KEY=

# 以下可选；默认值适配 z.ai GLM 上游，按你的实际模型调整
CPA_SMOKE_BASE_URL=http://127.0.0.1:8317
CPA_SMOKE_MODEL_PASSTHROUGH=glm-5.2
CPA_SMOKE_MODEL_CHAIN_SRC=glm-5.1
CPA_SMOKE_MODEL_CHAIN_MID=glm-5
CPA_SMOKE_MODEL_CHAIN_DST=glm-5.2
# 若 unprefixed 请求路由不到上游，改用带前缀名：z.ai/glm-5.2 等
